<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- 监测状态和用户选择可能涉及外设路径，不参与云备份或设备迁移。 -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
